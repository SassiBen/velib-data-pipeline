{
  "uid": "velib-pipeline",
  "title": "Vélib' : pipeline et réseau",
  "schemaVersion": 39,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "1m",
  "panels": [
    {"type": "stat", "title": "Stations vides", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "velib_network_empty_stations", "refId": "A"}]},
    {"type": "stat", "title": "Stations pleines", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "velib_network_full_stations", "refId": "A"}]},
    {"type": "stat", "title": "Vélos disponibles", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "velib_network_bikes", "refId": "A"}]},
    {"type": "stat", "title": "Dernière écriture bronze (s)",
     "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
       {"color": "green", "value": null}, {"color": "orange", "value": 900},
       {"color": "red", "value": 1800}]}}},
     "targets": [{"expr": "velib_bronze_lag_seconds", "refId": "A"}]},
    {"type": "timeseries", "title": "Messages publiés par minute",
     "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum by (topic) (rate(velib_messages_total[5m])) * 60",
                  "legendFormat": "{{topic}}", "refId": "A"}]},
    {"type": "timeseries", "title": "Durée de collecte (p95, s)",
     "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(velib_poll_seconds_bucket[10m])))",
                  "refId": "A"}]},
    {"type": "timeseries", "title": "Erreurs de collecte",
     "gridPos": {"x": 0, "y": 13, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "increase(velib_poll_errors_total[15m])", "refId": "A"}]},
    {"type": "timeseries", "title": "Stations remontées",
     "gridPos": {"x": 12, "y": 13, "w": 12, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "velib_stations_reporting", "refId": "A"}]}
  ]
}
